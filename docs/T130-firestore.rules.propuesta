rules_version = '2';

// PROPUESTA T-130 (Timonel, 3-nov-2026) para el proyecto de produccion
// baystream-app. Parte de docs/T127-firestore.rules.propuesta (lo que publica
// la 0.4.1) y solo agrega lo de la seccion 3.7 de docs/T130-RESULTADOS.md,
// aprobada por Carlos en 10.90 de SPRINT-4.md con el ajuste 4:
//
//  a. En operations/{id}, la oficina tambien puede actualizar con
//     validPlanAddition(): la operacion sigue abierta, solo cambia `sources`,
//     y de `sources` solo se AGREGA la entrada del BAPLIE que faltaba
//     (`arrival_baplie` o `loading_baplie`; la otra y `export_list` quedan
//     iguales), con fileName, sha256, parts, length y, si el archivo declara
//     otro viaje que la operacion, `voyage` (<= 40). Nunca reemplaza ni quita.
//  b. En sources/{sourceId}, validSource acepta ademas los trozos
//     `{tipo}-{i}` de un BAPLIE agregado (validAddedPart): sin `revision`,
//     con la huella y el numero de trozos que la entrada del manifiesto
//     declara despues del lote (getAfter), y el id `{tipo}-{i}`.
//  c. El trozo publicado (validPublishedPart) solo nace con la operacion, en
//     su lote: `op.createdAt == request.time`, con el op que getAfter ya
//     trae. Sin exists() ni get() de mas: por trozo siguen siendo los tres
//     accesos de T-80 (la lista de autorizados y getAfter de la operacion).
//
// Los BAPLIE siguen sin cambiar: son el contrato de las claves naturales de
// los movimientos. Las reglas de los movimientos, del cierre y de la revision
// del listado no cambian. Carlos la publica desde la consola despues de la
// aceptacion de Codex y antes de los clientes de la 0.4.2; lo publicado se
// coteja con este archivo (tool/t113_reglas.mjs). Lo demas es el texto de
// T-127, tal cual.
//
// PROPUESTA T-127 (Timonel, 29-oct-2026) para el proyecto de produccion
// baystream-app. Parte de docs/T80-firestore.rules.propuesta, que es lo
// publicado (10.108 de SPRINT-3.md), y solo agrega las dos clausulas de la
// seccion 8.3 de docs/T122-RESULTADOS.md, aprobadas en 10.78 de SPRINT-4.md:
//
//  a. En operations/{id}, la oficina tambien puede actualizar con
//     validListRevision(): la operacion sigue abierta, solo cambia `sources`,
//     y de `sources` solo la entrada `export_list` (las de los dos BAPLIE
//     quedan iguales), con fileName, sha256, parts, length y un entero
//     `revision` mayor que el anterior, o 1 si no habia listado.
//  b. En sources/{sourceId}, validSource acepta ademas los trozos
//     `export_list-r{revision}-{i}`, con un campo `revision` igual al que
//     getAfter ve en el manifiesto, y la huella y el numero de trozos del
//     manifiesto.
//
// Los trozos anteriores no se actualizan ni se borran (siguen cerrados): son
// historia, y quien lee se queda con los de la revision que el manifiesto
// declara. Los BAPLIE no cambian. Las reglas de los movimientos no cambian.
// Carlos la publica desde la consola despues de la aceptacion de Codex y
// antes de los clientes de la 0.4.1; lo publicado se coteja con este archivo
// (tool/t113_reglas.mjs). Lo demas es el texto de T-80, tal cual.
//
// PROPUESTA T-80 (Capitan Codex, 11-oct-2026) para el proyecto de produccion
// baystream-app. NO es firestore.rules de la raiz: ese archivo es del proyecto
// de H5 y no se toca. Carlos la publica desde la consola cuando T-79 la haya
// verificado en el emulador. Diseno completo en docs/T79a-DISENO.md.
//
// Principios:
//  1. Solo entra quien esta en la lista de autorizados (authorized/{uid}),
//     activo, con un rol: 'dock' (muelle) u 'office' (oficina). La lista la
//     escribe Carlos desde la consola; ningun cliente puede escribirla.
//  2. La bitacora es solo de anexar: un movimiento se crea una vez y nunca se
//     edita ni se borra. Se anula con otro movimiento. La unica "actualizacion"
//     permitida es el reenvio identico del propio autor (idempotencia de la
//     cola), que solo puede tocar la hora de recepcion del servidor.
//  3. Lo que no esta declarado aqui esta cerrado.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identidad

    function signedIn() {
      return request.auth != null;
    }

    function authorizedPath() {
      return /databases/$(database)/documents/authorized/$(request.auth.uid);
    }

    // Una cuenta que existe en Authentication pero no esta en la lista no
    // entra. Tampoco una que Carlos marco active == false.
    function isAuthorized() {
      return signedIn()
        && exists(authorizedPath())
        && get(authorizedPath()).data.active == true;
    }

    function role() {
      return get(authorizedPath()).data.role;
    }

    function isOffice() {
      return isAuthorized() && role() == 'office';
    }

    // ------------------------------------------------------------------ formatos

    function isUuid(value) {
      return value is string
        && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    // Posicion de estiba ISO (BBBRRTT); algunos archivos la traen de 6 cifras.
    function isPosition(value) {
      return value is string && value.matches('^[0-9]{6,7}$');
    }

    function isReason(value) {
      return value is string && value.size() >= 1 && value.size() <= 300;
    }

    function optional(m, key, kind) {
      return !(key in m)
        || (kind == 'string' && m[key] is string && m[key].size() <= 60)
        || (kind == 'int' && m[key] is int && m[key] > 0)
        || (kind == 'timestamp' && m[key] is timestamp)
        || (kind == 'uuid' && isUuid(m[key]));
    }

    // ---------------------------------------------------- lista de autorizados

    // Cada usuario lee solo su propio registro, para conocer su rol.
    match /authorized/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // --------------------------------------------------------------- operaciones

    // Una operacion es una escala de un buque: la publica la oficina con sus
    // fuentes (BAPLIE de llegada, plan de carga, listado normalizado).
    match /operations/{operationId} {
      allow get, list: if isAuthorized();
      allow create: if isOffice() && validNewOperation(operationId);
      // T-127: cerrar, o agregar/reemplazar el listado mientras siga abierta.
      // T-130: o agregar el BAPLIE que falta, tambien mientras siga abierta.
      allow update: if isOffice()
        && (validClosing() || validListRevision() || validPlanAddition());
      allow delete: if false;

      function validNewOperation(id) {
        let d = request.resource.data;
        let fields = ['id', 'schema', 'vessel', 'voyage', 'portOfCall', 'status',
                      'createdBy', 'createdAt', 'profile', 'sources'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.id == id && isUuid(id)
          && d.schema == 1
          && d.vessel is string && d.vessel.size() <= 80
          && d.voyage is string && d.voyage.size() <= 40
          && d.portOfCall is string && d.portOfCall.matches('^[A-Z]{2}[A-Z0-9]{3}$')
          && d.status == 'open'
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time
          && d.profile is map
          && d.sources is map;
      }

      // Cerrar es la unica edicion: abierta -> cerrada, una vez, con quien y cuando.
      function validClosing() {
        let d = request.resource.data;
        return resource.data.status == 'open'
          && d.status == 'closed'
          && d.closedBy == request.auth.uid
          && d.closedAt == request.time
          && d.diff(resource.data).affectedKeys().hasOnly(['status', 'closedBy', 'closedAt']);
      }

      // T-127 (10.78): la oficina agrega o reemplaza el listado de la agencia
      // mientras la operacion siga abierta. Solo cambia `sources`, y de
      // `sources` solo `export_list`: los BAPLIE son el contrato de las claves
      // naturales de los movimientos y no cambian. La entrada nueva trae un
      // entero `revision` mayor que el anterior, o 1 si no habia listado. Sus
      // trozos van en el mismo lote (validRevisionPart los ve con getAfter).
      function validListRevision() {
        let before = resource.data;
        let after = request.resource.data;
        return before.status == 'open'
          && after.diff(before).affectedKeys().hasOnly(['sources'])
          && after.sources is map
          && after.sources.diff(before.sources).affectedKeys().hasOnly(['export_list'])
          && 'export_list' in after.sources
          && validListEntry(after.sources.export_list,
                            'export_list' in before.sources,
                            listRevisionBefore(before.sources));
      }

      // La revision que tenia el listado: 0 si no habia listado o si se
      // publico junto con la operacion, sin `revision`.
      function listRevisionBefore(sources) {
        return !('export_list' in sources) ? 0
          : !('revision' in sources.export_list) ? 0
          : sources.export_list.revision;
      }

      function validListEntry(e, had, previous) {
        let fields = ['fileName', 'sha256', 'parts', 'length', 'revision'];
        return e is map
          && e.keys().hasOnly(fields) && e.keys().hasAll(fields)
          && e.fileName is string && e.fileName.size() >= 1 && e.fileName.size() <= 300
          && e.sha256 is string && e.sha256.matches('^[0-9a-f]{64}$')
          && e.parts is int && e.parts >= 1 && e.parts <= 20
          && e.length is int && e.length >= 0
          && e.revision is int
          && (had ? e.revision > previous : e.revision == 1);
      }

      // T-130 (10.90): la oficina agrega el BAPLIE que falta mientras la
      // operacion siga abierta. Solo cambia `sources`, y de `sources` solo
      // se agrega un tipo que no estaba: nunca se reemplaza ni se quita una
      // entrada. Sus trozos van en el mismo lote (validAddedPart los ve con
      // getAfter).
      function validPlanAddition() {
        let before = resource.data;
        let after = request.resource.data;
        return before.status == 'open'
          && after.diff(before).affectedKeys().hasOnly(['sources'])
          && after.sources is map
          && (validAddedPlan(before.sources, after.sources, 'arrival_baplie')
              || validAddedPlan(before.sources, after.sources, 'loading_baplie'));
      }

      // Agregar, nunca reemplazar ni quitar: el tipo no estaba, ahora esta,
      // y es lo unico que cambia en `sources`.
      function validAddedPlan(b, a, kind) {
        return !(kind in b) && kind in a
          && a.diff(b).affectedKeys().hasOnly([kind])
          && validPlanEntry(a[kind]);
      }

      // La entrada del BAPLIE agregado: como la publicada, mas `voyage` si el
      // archivo declara otro viaje que la operacion (3.3 de T-130).
      function validPlanEntry(e) {
        return e is map
          && e.keys().hasAll(['fileName', 'sha256', 'parts', 'length'])
          && e.keys().hasOnly(['fileName', 'sha256', 'parts', 'length', 'voyage'])
          && e.fileName is string && e.fileName.size() >= 1 && e.fileName.size() <= 300
          && e.sha256 is string && e.sha256.matches('^[0-9a-f]{64}$')
          && e.parts is int && e.parts >= 1 && e.parts <= 20
          && e.length is int && e.length >= 0
          && (!('voyage' in e)
              || (e.voyage is string && e.voyage.size() >= 1 && e.voyage.size() <= 40));
      }

      // Fuentes: el texto del BAPLIE en trozos y el listado normalizado. Se
      // escriben en el mismo lote que la operacion (getAfter la ve) y no cambian.
      // T-127: el listado puede volver a escribirse con revision, en trozos
      // nuevos; los anteriores siguen sin update ni delete.
      match /sources/{sourceId} {
        allow get, list: if isAuthorized();
        allow create: if isOffice() && validSource(operationId, sourceId);
        allow update, delete: if false;
      }

      function validSource(opId, id) {
        let d = request.resource.data;
        let op = getAfter(/databases/$(database)/documents/operations/$(opId)).data;
        return op.status == 'open'
          // T-130: un trozo sin revision solo nace con la operacion, en su
          // lote (ajuste 4 de 10.90: con el op que getAfter ya trae, sin
          // exists ni get de mas).
          && ((validPublishedPart(d, id) && op.createdAt == request.time)
              || validRevisionPart(d, id, op)
              || validAddedPart(d, id, op));
      }

      // Un trozo publicado junto con la operacion, sin `revision` (T-79, T-80).
      function validPublishedPart(d, id) {
        let fields = ['id', 'kind', 'sha256', 'part', 'parts', 'content',
                      'createdBy', 'createdAt'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.id == id
          && d.kind in ['arrival_baplie', 'loading_baplie', 'export_list']
          && d.sha256 is string && d.sha256.matches('^[0-9a-f]{64}$')
          && d.parts is int && d.parts >= 1 && d.parts <= 20
          && d.part is int && d.part >= 0 && d.part < d.parts
          && d.content is string && d.content.size() <= 900000
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // T-127: un trozo de una revision del listado, `export_list-r{n}-{i}`,
      // con la revision, la huella y el numero de trozos que el manifiesto
      // declara despues del lote (getAfter). Sin revision en el manifiesto no
      // hay trozo de revision que valga.
      function validRevisionPart(d, id, op) {
        let fields = ['id', 'kind', 'sha256', 'part', 'parts', 'content',
                      'createdBy', 'createdAt', 'revision'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.id == id
          && d.kind == 'export_list'
          && 'export_list' in op.sources
          && d.revision is int && d.revision >= 1
          && d.revision == op.sources.export_list.revision
          && d.part is int && d.part >= 0
          && id == 'export_list-r' + string(d.revision) + '-' + string(d.part)
          && d.sha256 is string && d.sha256 == op.sources.export_list.sha256
          && d.parts is int && d.parts == op.sources.export_list.parts
          && d.part < d.parts
          && d.content is string && d.content.size() <= 900000
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // T-130: un trozo `{tipo}-{i}` de un BAPLIE que se agrega despues de
      // publicar, en el mismo lote que su entrada del manifiesto (getAfter la
      // ve), con la huella y el numero de trozos que la entrada declara. Sin
      // get() ni exists(): un trozo de un tipo que ya estaba solo puede
      // apuntar a un id que ya existe (part < parts), y crear sobre un
      // documento que existe es un update, que esta cerrado; si el id no
      // existe, solo puede completar lo que el manifiesto ya declara.
      function validAddedPart(d, id, op) {
        let fields = ['id', 'kind', 'sha256', 'part', 'parts', 'content',
                      'createdBy', 'createdAt'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.id == id
          && d.kind in ['arrival_baplie', 'loading_baplie']
          && d.kind in op.sources
          && d.part is int && d.part >= 0
          && id == d.kind + '-' + string(d.part)
          && d.sha256 is string && d.sha256 == op.sources[d.kind].sha256
          && d.parts is int && d.parts == op.sources[d.kind].parts
          && d.part < d.parts
          && d.content is string && d.content.size() <= 900000
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // ---------------------------------------------------------- movimientos

      match /movements/{movementId} {
        allow get, list: if isAuthorized();
        allow create: if isAuthorized() && validMovement(operationId, movementId);
        // Reenvio de la cola: mismo autor, mismo contenido, solo cambia la hora
        // en que el servidor lo recibio. No altera nada que use la derivacion.
        allow update: if isAuthorized()
          && resource.data.author.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt'])
          && request.resource.data.receivedAt == request.time;
        allow delete: if false;
      }

      function dockTypes() {
        return ['discharge', 'load_full', 'assign_empty', 'annul',
                'request_change', 'hatch_cover'];
      }

      function officeTypes() {
        return ['discharge', 'load_full', 'assign_empty', 'annul',
                'request_change', 'hatch_cover',
                'cancel_item', 'change_position', 'reject_change'];
      }

      function validMovement(opId, id) {
        let d = request.resource.data;
        let r = role();
        let op = get(/databases/$(database)/documents/operations/$(opId)).data;
        let fields = ['id', 'schema', 'operationId', 'type', 'target', 'payload',
                      'author', 'deviceId', 'sequence', 'createdAt', 'receivedAt'];
        return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
          && d.id == id && isUuid(id)
          && d.schema == 1
          && d.operationId == opId
          && d.author is map
          && d.author.keys().hasOnly(['uid', 'name', 'role'])
          && d.author.keys().hasAll(['uid', 'name', 'role'])
          && d.author.uid == request.auth.uid
          && d.author.role == r
          && d.author.name is string && d.author.name.size() >= 1 && d.author.name.size() <= 80
          && isUuid(d.deviceId)
          && d.sequence is int && d.sequence >= 1
          && d.createdAt is timestamp
          && d.createdAt <= request.time + duration.value(10, 'm')
          && d.createdAt >= request.time - duration.value(7, 'd')
          && d.receivedAt == request.time
          // Abierta, o cerrada despues de que el movimiento se registro sin red.
          && (op.status == 'open' || d.createdAt <= op.closedAt)
          && (r == 'office' && d.type in officeTypes() || r == 'dock' && d.type in dockTypes())
          && d.payload is map
          && validPayload(opId, d.type, d.target, d.payload, r);
      }

      function validPayload(opId, type, target, p, r) {
        return type == 'discharge' ? validDischarge(opId, target, p, r)
          : type == 'load_full' ? validLoadFull(opId, target, p, r)
          : type == 'assign_empty' ? validAssignEmpty(opId, target, p, r)
          : type == 'annul' ? validAnnul(opId, target, p, r)
          : type == 'cancel_item' ? validCancel(opId, target, p, r)
          : type == 'request_change' ? validRequestChange(opId, target, p, r)
          : type == 'change_position' ? validChangePosition(opId, target, p, r)
          : type == 'reject_change' ? validRejectChange(opId, target, p, r)
          : type == 'hatch_cover' ? validHatchCover(opId, target, p, r)
          : false;
      }

      function validDischarge(opId, target, p, r) {
        return target is string && target.matches('^C:[A-Z0-9]{1,17}$')
            && p.keys().hasOnly(['position', 'restow', 'reason', 'operatedAt', 'corrects'])
            && isPosition(p.position) && p.restow is bool
            && (!('reason' in p) || isReason(p.reason))
            && optional(p, 'operatedAt', 'timestamp') && optional(p, 'corrects', 'uuid');
      }

      function validLoadFull(opId, target, p, r) {
        return target is string && target.matches('^C:[A-Z0-9]{1,17}$')
            && p.keys().hasOnly(['order', 'position', 'seal', 'operatedAt', 'corrects', 'reason'])
            && isPosition(p.position)
            && optional(p, 'order', 'int') && optional(p, 'seal', 'string')
            && (!('reason' in p) || isReason(p.reason))
            && optional(p, 'operatedAt', 'timestamp') && optional(p, 'corrects', 'uuid');
      }

      function validAssignEmpty(opId, target, p, r) {
        return target is string && target.matches('^R:[0-9]{6,7}$')
            && p.keys().hasOnly(['order', 'container', 'tareKg', 'seal', 'operatedAt', 'corrects', 'reason'])
            && p.container is string && p.container.matches('^[A-Z0-9]{1,17}$')
            && p.tareKg is number && p.tareKg > 0 && p.tareKg < 15000
            && optional(p, 'order', 'int') && optional(p, 'seal', 'string')
            && (!('reason' in p) || isReason(p.reason))
            && optional(p, 'operatedAt', 'timestamp') && optional(p, 'corrects', 'uuid');
      }

      function validAnnul(opId, target, p, r) {
        return (target == null || target is string)
            && p.keys().hasOnly(['annuls', 'reason']) && p.keys().hasAll(['annuls', 'reason'])
            && isUuid(p.annuls) && isReason(p.reason)
            // El muelle solo anula movimientos de muelle; la oficina, cualquiera.
            && (r == 'office'
              || get(/databases/$(database)/documents/operations/$(opId)/movements/$(p.annuls)).data.type in dockTypes());
      }

      function validCancel(opId, target, p, r) {
        return target is string && target.matches('^(C:[A-Z0-9]{1,17}|R:[0-9]{6,7})$')
            && p.keys().hasOnly(['reason']) && isReason(p.reason);
      }

      function validRequestChange(opId, target, p, r) {
        return target == null
            && p.keys().hasOnly(['changes', 'reason']) && p.keys().hasAll(['changes', 'reason'])
            && validChanges(p.changes)
            && isReason(p.reason);
      }

      function validChangePosition(opId, target, p, r) {
        return target == null
            && p.keys().hasOnly(['changes', 'request', 'reason']) && p.keys().hasAll(['changes', 'reason'])
            && validChanges(p.changes)
            && optional(p, 'request', 'uuid') && isReason(p.reason);
      }

      function validRejectChange(opId, target, p, r) {
        return target == null
            && p.keys().hasOnly(['request', 'reason']) && p.keys().hasAll(['request', 'reason'])
            && isUuid(p.request) && isReason(p.reason);
      }

      function validHatchCover(opId, target, p, r) {
        return target is string && target.matches('^T:[0-9]{1,3}-[1-9]$')
            && p.keys().hasOnly(['action', 'operatedAt', 'corrects']) && p.keys().hasAll(['action'])
            && p.action in ['remove', 'replace']
            && optional(p, 'operatedAt', 'timestamp') && optional(p, 'corrects', 'uuid');
      }
      function validChange(c) {
        return c is map && c.keys().hasOnly(['target', 'from', 'to'])
          && c.keys().hasAll(['target', 'from', 'to'])
          && c.target is string
          && c.target.matches('^(C:[A-Z0-9]{1,17}|R:[0-9]{6,7})$')
          && isPosition(c.from) && isPosition(c.to);
      }
      function validChanges(c) {
        return c is list && c.size() >= 1 && c.size() <= 4
          && validChange(c[0])
          && (c.size() < 2 || validChange(c[1]))
          && (c.size() < 3 || validChange(c[2]))
          && (c.size() < 4 || validChange(c[3]));
      }
    }

    // Todo lo demas, cerrado. Incluye 'voyages' y 'latency_test': en
    // produccion no los usa ninguna pantalla; son del proyecto de H5.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
